{
  "name": "boardflow",
  "version": "2.3.0",
  "description": "A cross-platform teaching whiteboard for Windows and Android.",
  "author": "FadFlow",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "npm run build:web && electron .",
    "dev:web": "vite",
    "preview:web": "npm run build:web && vite preview --host 127.0.0.1 --open",
    "build:web": "vite build",
    "check:syntax": "node --check main.cjs && node --check preload.cjs && node --check src/renderer/app.js && node --check src/renderer/classroom-suite.js && node --check src/renderer/equation-recognition.js && node --check src/renderer/handwriting-recognition.js && node --check src/renderer/ink-shape-recognition.js && node --check src/renderer/math-tools.js && node --check src/renderer/math-intelligence.js",
    "lint": "eslint .",
    "check": "npm run check:syntax && npm run lint",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "npm run build:web && node --test tests/subject-checkpoints.test.cjs",
    "test:electron": "npm run build:web && node --test tests/electron-smoke.test.cjs",
    "test": "npm run check && npm run test:unit && npm run test:e2e && npm run test:electron",
    "audit": "npm audit",
    "android:add": "cap add android",
    "prepare:web": "npm run build:web",
    "android:sync": "npm run build:web && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.cjs",
    "android:open": "cap open android",
    "build:windows": "npm run build:web && electron-builder --win"
  },
  "build": {
    "appId": "com.fadflow.boardflow",
    "productName": "BoardFlow",
    "npmRebuild": false,
    "asarUnpack": [
      "scripts/recognize-ink.ps1"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "scripts/recognize-ink.ps1",
      "www/**",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "fabric": "^7.4.0",
    "globals": "^17.12.0",
    "mathjs": "^15.2.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@huggingface/transformers": "^4.3.1",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
