{
  "name": "boardflow",
  "version": "2.1.0",
  "main": "main.js",
  "build": {
    "appId": "com.fadflow.boardflow",
    "productName": "BoardFlow",
    "files": [
      "main.js",
      "app.js",
      "math.js",
      "index.html",
      "icon.png",
      "libs/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  }
}